# ============================================================
# derleyici_sonsuz_dongu.tan — DONMUŞ REGRESYON (2026-09-06, Faz 2-a)
# ------------------------------------------------------------
# ÇÖZÜLDÜ (Faz 2-b, commit 39bae3e): kök neden islevGovdeSonBul'un
# "değilse eğer" zincirini yanlış derinlik saymasıydı — bkz. TancElf.tan
# içindeki islevGovdeSonBul'un başındaki yorum. Bu dosya artık TAKILMIYOR,
# hızlı ve temiz `BAGLAMA HATASI: etiket bulunamadi: f_sözlük` veriyor
# (sözlük() zaten Faz 1'den beri yok — cikis kodu 0 DEĞİL, 1 bekleniyor,
# önemli olan 124/timeout OLMAMASI). Regresyon fixture'ı olarak KALICI:
# gelecekte bu bug geri gelirse (yanlış refactor vb.) burada yakalanır.
# ------------------------------------------------------------
# BU DOSYA KASITLI OLARAK TancElf'i SONSUZA KADAR ASAR (DÜZELTMEDEN ÖNCEKİ
# HALİYLE — artık asmıyor, bkz yukarı). TestAraclar.sh'nin
# `testler/*_testleri.tan` glob'una GİRMEYECEK ŞEKİLDE (bu alt dizinde,
# ayrı isim deseninde) yerleştirildi — normal regresyon koşusunu kilitlemesin
# diye. Bu dosyayı SADECE `timeout N ./TancElf ... ` ile, elle çalıştır.
#
# NE BULUNDU (izolasyon kanıtı, TAN — Faz 1 sonrası, sözlük öldürme
# görevi sırasında keşfedildi — sözlük'le İLGİSİZ, derleyici çekirdeği
# bug'ı):
#
#   `kutuphane/BAgaci.tan`'ı derlemeye çalışırken TancElf 4+ dakika %100
#   CPU'da donup hiç bitmedi (normalde saniyeler sürer). Bisection +
#   yaz()-marker enstrümantasyonuyla izole edildi:
#
#   1) Taramageçişleri (islevDonusTipleriTara, parametreTipleriniTara,
#      ulasilabilirIslevleriTara) HEPSİ hızlı ve doğru tamamlanıyor —
#      marker'lar bunu kanıtladı (bkz. asagidaki "yaz marker" kaniti).
#      Donma bunlarda DEĞİL, `blokDerle` (kod üretim geçişi) içinde.
#
#   2) Minimal tetikleyici: `her X liste içinde ... son` (foreach)
#      GÖVDESİ İÇİNDE bir `eğer ... ise ... değilse eğer ... ise ... son`
#      (elif) zinciri. TEK BAŞINA (küçük/sentetik dosyada, 0-14 sahte
#      fonksiyon önekiyle denendi) bu desen HİÇ donmuyor (bkz. synth_0..14
#      testleri, hepsi temiz derlendi). `parçala()` çağrısının varlığı/
#      yokluğu SONUCU DEĞİŞTİRMİYOR (P2: sadece parçala, elif yok → donmuyor;
#      P1: sadece elif, parçala yok → DONUYOR).
#
#   3) Donma SADECE bu elif-içinde-foreach deseni, BAgaci.tan'ın kendi ilk
#      128 satırının (globaller + araligi + digerleriEkleyerekOlustur +
#      bagacAyarla + bagacDugumOlustur + yaprakBol fonksiyonları, aşağıda
#      DONDURULMUŞ KOPYA olarak birebir gömülü) ARDINDAN geldiğinde ortaya
#      çıkıyor. İlk 105 satır (yaprakBol HARİÇ) yeterli DEĞİL — donma yok,
#      temiz `BAGLAMA HATASI: etiket bulunamadi: f_sözlük` veriyor. yaprakBol
#      dahil olunca (111-128 satır) donma başlıyor. GERÇEK SEBEP (Faz 2-b'de
#      bulundu): "belli bir önceki karmaşıklık" aslında sadece "dosyada
#      BAŞKA bir top-level çağrı olması" (reachability budamasını aktif
#      eden şart, TancElf.tan satır ~1007) — foreach de gerekli değildi,
#      düz `eğer/değilse eğer` tek başına da (foreach'siz) aynı şekilde
#      donduruyordu (bkz C4 testi, fix commit mesajında).
#
#   4) sözlük() ile İLGİSİZ olduğu doğrulandı: bu dosyadaki sözlük()
#      çağrıları (kYaprakMi/kAnahtarlar/vb.) zaten link aşamasında ayrı
#      ayrı temiz hata verir (bkz Faz 1 kapanışı) — donma bundan farklı bir
#      AŞAMADA (blokDerle, linkten ÖNCE) oluyor, sözlük'ün varlığı/yokluğu
#      donma davranışını DEĞİŞTİRMEDİ (denendi: sözlük() çağrıları çıkarılıp
#      düz skaler değişkenle değiştirilince de aynı donma sürdü).
#
# YENİDEN ÜRETME (regresyon kontrolü):
#   cd tan/ (repo kökü)
#   timeout 10 ./TancElf testler/regresyon/derleyici_sonsuz_dongu.tan /tmp/out
#   # DÜZELTMEDEN SONRA (şu an): hızlı, cikis kodu 124 DEĞİL — 1, çıktı
#   # "BAGLAMA HATASI: etiket bulunamadi: f_sözlük" (sözlük zaten yok,
#   # Faz 1'den beklenen doğru davranış). cikis kodu 124 görülürse REGRESYON
#   # var demektir — bug geri gelmiş.
# ============================================================

kKokKutu = [0]
kDereceKutu = [4]
kWalYoluKutu = [""]
kSayacKutu = [0]
kYaprakMi = sözlük()
kAnahtarlar = sözlük()
kDegerler = sözlük()
kCocuklar = sözlük()
kSonraki = sözlük()

işlev araligi(liste, bas, sonIndeks)
    sonuc = []
    i = bas
    iken i < sonIndeks
        sonuc = ekle(sonuc, liste[i])
        i = i + 1
    son
    döndür sonuc
son

işlev digerleriEkleyerekOlustur(liste, konum, deger)
    sonuc = []
    i = 0
    iken i < konum
        sonuc = ekle(sonuc, liste[i])
        i = i + 1
    son
    sonuc = ekle(sonuc, deger)
    iken i < uzunluk(liste)
        sonuc = ekle(sonuc, liste[i])
        i = i + 1
    son
    döndür sonuc
son

işlev bagacAyarla(derece, walYolu)
    kDereceKutu[0] = derece
    kWalYoluKutu[0] = walYolu
son

işlev bagacDugumOlustur(yaprakMi)
    id = kSayacKutu[0]
    kSayacKutu[0] = id + 1
    kYaprakMi[id] = yaprakMi
    kAnahtarlar[id] = []
    kDegerler[id] = []
    kCocuklar[id] = []
    kSonraki[id] = 0 - 1
    döndür id
son

kKokKutu[0] = bagacDugumOlustur(1)

işlev yaprakBol(dugumId)
    anahtarlar = kAnahtarlar[dugumId]
    degerler = kDegerler[dugumId]
    n = uzunluk(anahtarlar)
    orta = tamBol(n, 2)
    solAnahtarlar = araligi(anahtarlar, 0, orta)
    solDegerler = araligi(degerler, 0, orta)
    sagAnahtarlar = araligi(anahtarlar, orta, n)
    sagDegerler = araligi(degerler, orta, n)
    yeniId = bagacDugumOlustur(1)
    kAnahtarlar[dugumId] = solAnahtarlar
    kDegerler[dugumId] = solDegerler
    kAnahtarlar[yeniId] = sagAnahtarlar
    kDegerler[yeniId] = sagDegerler
    kSonraki[yeniId] = kSonraki[dugumId]
    kSonraki[dugumId] = yeniId
    döndür [sagAnahtarlar[0], yeniId]
son

# --- TETİKLEYİCİ: minimal desen (P1, izole edilmiş minimal hâli) ---
# foreach GÖVDESİ İÇİNDE eğer/değilse eğer (elif) zinciri — bu, yukarıdaki
# 5 fonksiyonun (özellikle yaprakBol'un) ARDINDAN gelince donuyor. Tek
# başına (bkz. synth_N testleri, dosya başlığı) donmuyor.
işlev tetikleyici()
    satirlar = [1, 2, 3]
    her satir satirlar içinde
        eğer satir == 1 ise
            yaz(1)
        değilse eğer satir == 2 ise
            yaz(2)
        son
    son
    döndür 1
son

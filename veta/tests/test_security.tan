# test_security.tan — VETA Security Core (guvenlikAc/guvenlikKullaniciEkle/
# guvenlikDogrula/guvenlikIzinVer/guvenlikYetkiliMi/guvenlikDenetimKaydet/
# guvenlikDenetimDogrula) testleri.

içe al "kutuphane/test.tan"
içe al "../libraries/security/source/security.tan"

gecti = 0
toplam = 0

g = guvenlikAc()
g = guvenlikKullaniciEkle(g, "demir", "sifre123")

toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikDogrula(g, "demir", "sifre123"), "guvenlikDogrula: dogru sifre kabul ediliyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikDogrula(g, "demir", "yanlis"), "guvenlikDogrula: yanlis sifre reddediliyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikDogrula(g, "olmayan", "xxx"), "guvenlikDogrula: olmayan kullanici reddediliyor")

g = guvenlikIzinVer(g, "demir", "yaz")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikYetkiliMi(g, "demir", "yaz"), "guvenlikYetkiliMi: verilen izin taniniyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikYetkiliMi(g, "demir", "sil"), "guvenlikYetkiliMi: verilmemis izin reddediliyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikYetkiliMi(g, "baskasi", "yaz"), "guvenlikYetkiliMi: baska kullanici izni almiyor")

# audit hash-chain
g = guvenlikDenetimKaydet(g, "demir", "giris", "basarili")
g = guvenlikDenetimKaydet(g, "demir", "yaz-yapti", "basarili")
g = guvenlikDenetimKaydet(g, "baskasi", "giris", "basarisiz")

toplam = toplam + 1
gecti = gecti + iddiaSayi(3, guvenlikDenetimSayisi(g), "guvenlikDenetimKaydet: 3 kayit eklendi")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikDenetimDogrula(g), "guvenlikDenetimDogrula: temiz zincir gecerli")

# KRITIK: zinciri kurcala (bir kaydin sonuc alanini degistir) - dogrulama BOZULMALI
denetim = g[2]
kurcalanan = denetim[1]
kurcalanan[3] = "kurcalandi"
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikDenetimDogrula(g), "guvenlikDenetimDogrula: kurcalanan kayit tespit ediliyor")

# --- RBAC rol katmani ---
g = guvenlikRolVer(g, "demir", "editor")
roller = guvenlikKullaniciRolleri(g, "demir")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, uzunluk(roller), "guvenlikRolVer: kullaniciya 1 rol atandi")

g = guvenlikRolIzinVer(g, "editor", "sil")
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikYetkiliMi(g, "demir", "sil"), "guvenlikYetkiliMi: DOGRUDAN izin hala yok (rol ayri)")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikRolYetkiliMi(g, "demir", "sil"), "guvenlikRolYetkiliMi: rol uzerinden izin taniniyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikYetkiliMiTam(g, "demir", "sil"), "guvenlikYetkiliMiTam: rol uzerinden izni de kabul ediyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikYetkiliMiTam(g, "demir", "yaz"), "guvenlikYetkiliMiTam: dogrudan izni de kabul ediyor")
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikYetkiliMiTam(g, "demir", "olmayan-izin"), "guvenlikYetkiliMiTam: ne dogrudan ne rolle olan izin reddediliyor")

# rolu olmayan baska kullanici etkilenmemeli
toplam = toplam + 1
gecti = gecti + iddiaSayi(0, guvenlikRolYetkiliMi(g, "baskasi", "sil"), "guvenlikRolYetkiliMi: rolu olmayan kullanici izin almiyor")

# ayni rolu tekrar atama - liste buyumemeli (idempotent)
g = guvenlikRolVer(g, "demir", "editor")
rollerTekrar = guvenlikKullaniciRolleri(g, "demir")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, uzunluk(rollerTekrar), "guvenlikRolVer: ayni rol tekrar ataninca liste buyumuyor")

# ikinci rol ekleme
g = guvenlikRolVer(g, "demir", "denetci")
g = guvenlikRolIzinVer(g, "denetci", "denetim-oku")
toplam = toplam + 1
gecti = gecti + iddiaSayi(2, uzunluk(guvenlikKullaniciRolleri(g, "demir")), "guvenlikRolVer: ikinci rol eklendi, toplam 2")
toplam = toplam + 1
gecti = gecti + iddiaSayi(1, guvenlikRolYetkiliMi(g, "demir", "denetim-oku"), "guvenlikRolYetkiliMi: ikinci rolun izni de taniniyor")

d = testSonuc(gecti, toplam)
